---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const title = 'Brandon Lopez | Ingeniero en Desarrollo de Software';
const description =
  'Portafolio de Brandon Lopez, ingeniero de software en Monterrey con experiencia en automatización, Java, Spring, JavaScript, TypeScript y Python.';
---
<meta name="facebook-domain-verification" content="9t7tvtsckv1w93lza9u7swglfi9we4" />
<BaseLayout title={title} description={description}>
  <section class="hero section" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Ingeniero de software · Monterrey, México</p>
        <h1 id="hero-title">Software confiable para automatizar y operar mejor.</h1>
        <p class="hero-intro">
          Soy <strong>Brandon Lopez</strong>. Diseño backend, integraciones y herramientas
          operativas con Java, Spring, TypeScript y Python. Convierto procesos complejos en
          soluciones claras, mantenibles y enfocadas en el trabajo real de las personas.
        </p>
        <div class="hero-actions">
          <a class="button" href="#proyectos">Ver proyectos</a>
          <a
            class="text-link"
            href="mailto:brandon1697@live.com.mx?subject=Oportunidad%20profesional"
          >
            Contactar <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <aside class="profile-card" aria-label="Resumen profesional">
        <div class="profile-card-header">
          <div class="monogram" aria-hidden="true">LC</div>
          <div>
            <p class="profile-name">Brandon Lopez</p>
            <p class="profile-location">Monterrey · Nuevo León</p>
          </div>
        </div>
        <dl class="profile-list">
          <div>
            <dt>Especialidad</dt>
            <dd>Backend y automatización</dd>
          </div>
          <div>
            <dt>También construyo</dt>
            <dd>Integraciones y aplicaciones operativas</dd>
          </div>
          <div>
            <dt>Forma de trabajo</dt>
            <dd>Análisis, seguridad y calidad</dd>
          </div>
        </dl>
        <p class="availability"><span aria-hidden="true"></span> Abierto a oportunidades</p>
      </aside>
    </div>
  </section>

  <section id="proyectos" class="projects section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Trabajo seleccionado</p>
          <h2 id="projects-title">Soluciones que muestran cómo trabajo.</h2>
        </div>
        <p>
          Cuatro proyectos públicos con contexto, decisiones técnicas comprobables y acceso
          directo al código.
        </p>
      </div>
      <div class="projects-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="contact section" aria-labelledby="contact-title">
    <div class="container">
      <div class="contact-panel">
        <div>
          <p class="eyebrow">Contacto</p>
          <h2 id="contact-title">¿Tienes un proceso que mejorar?</h2>
          <p>
            Estoy disponible para oportunidades de desarrollo de software y automatización.
            Cuéntame brevemente el reto por correo.
          </p>
        </div>
        <a class="button button-light" href="mailto:brandon1697@live.com.mx?subject=Oportunidad%20profesional">
          brandon1697@live.com.mx
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
