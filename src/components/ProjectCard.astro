---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="project-card" aria-labelledby={`project-${project.slug}`}>
  <div class={`project-visual visual-${(index % 4) + 1}`}>
    {
      project.video ? (
        <>
          <video
            controls
            playsinline
            preload="none"
            poster={project.image}
            width="1600"
            height="900"
            aria-label={project.video.label}
          >
            <source src={project.video.src} type="video/mp4" />
            <a href={project.video.src}>Descargar la demostración en video</a>
          </video>
          <span class="media-label">Video · 15 s</span>
        </>
      ) : (
        <img
          src={project.image}
          alt={project.imageAlt}
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
  <div class="project-content">
    <div class="project-heading">
      <p class="project-focus">{project.focus}</p>
      <div class="project-title-row">
        <h3 id={`project-${project.slug}`}>{project.title}</h3>
        <p class="project-number" aria-hidden="true">0{index + 1}</p>
      </div>
    </div>
    <p class="project-description">{project.description}</p>
    <ul class="tag-list" aria-label={`Tecnologías de ${project.title}`}>
      {project.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <a
      class="project-link"
      href={project.repositoryUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Ver ${project.title} en GitHub (abre en una pestaña nueva)`}
    >
      Ver repositorio
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
